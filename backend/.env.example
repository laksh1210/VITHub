# ==========================================================
# VITHub Backend — Environment Variable Reference
# Copy to .env (or set in your platform's env config) and fill in.
# ==========================================================

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev

# --- Database (PostgreSQL / Neon) ---
DB_URL=jdbc:postgresql://localhost:5432/vithub
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Server ---
SERVER_PORT=8080

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-256-bit-secret
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Logging ---
LOG_LEVEL=DEBUG
JPA_SHOW_SQL=false
